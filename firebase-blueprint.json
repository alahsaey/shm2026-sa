{
  "entities": {
    "Category": {
      "title": "Category",
      "description": "Competition Category",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "group": { "type": "string" },
        "description": { "type": "string" },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" }
      },
      "required": ["name"]
    },
    "Question": {
      "title": "Question",
      "description": "Category Question",
      "type": "object",
      "properties": {
        "categoryId": { "type": "string" },
        "text": { "type": "string" },
        "answer": { "type": "string" },
        "points": { "type": "number" }
      },
      "required": ["categoryId", "text", "answer", "points"]
    },
    "GameSession": {
      "title": "GameSession",
      "description": "Game Session History",
      "type": "object",
      "properties": {
        "creatorId": { "type": "string" },
        "isCompleted": { "type": "boolean" }
      }
    },
    "AppSettings": {
      "title": "AppSettings",
      "description": "Global Application Settings",
      "type": "object",
      "properties": {
        "competitionName": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "List of categories"
    },
    "/questions/{questionId}": {
      "schema": { "$ref": "#/entities/Question" },
      "description": "List of questions"
    },
    "/game_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/GameSession" },
      "description": "Recorded game sessions"
    },
    "/settings/{settingsId}": {
      "schema": { "$ref": "#/entities/AppSettings" },
      "description": "Global app settings"
    }
  }
}
