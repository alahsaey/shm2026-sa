rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'alahsaey@gmail.com'
      );
    }

    // Test doc for connection check
    match /test/{testId} {
      allow read: if true;
    }

    // Groups
    match /groups/{groupId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories and their subcollection questions
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();

      match /questions/{questionId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Top-level questions (if referenced directly)
    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Sessions and their live reactions subcollection
    match /sessions/{sessionId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();

      match /reactions/{reactionId} {
        allow read, create: if true;
        allow update, delete: if isAdmin();
      }
    }

    // Legacy game_sessions (if referenced)
    match /game_sessions/{sessionId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();

      match /reactions/{reactionId} {
        allow read, create: if true;
        allow update, delete: if isAdmin();
      }
    }

    // Settings
    match /settings/{settingsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Live Reactions top-level (if referenced directly)
    match /live_reactions/{reactionId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
